# 生产环境 .env 模板（部署参考用）
# ──────────────────────────────────────────────────────────────
# 用法：
#   1. 把本文件复制为服务器上的 .env：`cp .env.production.example .env`
#   2. 编辑 .env，把 SMTP_PASS、VITE_API_BASE、ADMIN_TOKEN 改成真实数据
#   3. 任何包含 "TODO" 的字段都必须改成实际值才能启动
# ──────────────────────────────────────────────────────────────

# 火山引擎 ARK 凭据（图片生成服务）
ARK_AK=TODO_your_ARK_access_key
ARK_SK=TODO_your_ARK_secret_key
ARK_PROJECT=defult
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=TODO_your_ARK_api_key

# SMTP 邮件配置（询盘通知）
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465
# 需要在 QQ 邮箱后台开启 SMTP 并获取授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=TODO_你的QQ邮箱
SMTP_PASS=TODO_你的QQ邮箱授权码
NOTIFY_EMAIL=info@quarkdairy.cn

# 管理后台登录 Token（/admin 路由）
# 生产环境必须重新生成：`openssl rand -hex 32`
ADMIN_TOKEN=TODO_run_openssl_rand_hex_32

# 前端环境变量（Vite 必须以 VITE_ 开头）
# WhatsApp 国际号码（不带 + 号）
VITE_WHATSAPP_NUMBER=36303969879
# 后端 API 地址（生产环境改为实际域名）
VITE_API_BASE=TODO_https://你的域名